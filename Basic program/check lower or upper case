//to check a character is upper case or lower case
#include<stdio.h>
void main()
{
	char ch;
	printf("enter a character");
	scanf("%c",&ch);
	if(ch>='A' && ch<='Z')
	printf("the character is uppercase");
	else if(ch>='a' && ch<='z')
	printf("the character is lowercase");
	else
	printf("the input is not an alphabet");
	
}
